   
<div class="cart-wedgit">

  <a href="#" class="caret-btn">
    <i class="fas fa-shopping-cart"></i>
    <span data-total-count>{{ cart.item_count }}</span>
    <span>{{ 'layout.cart.items_count' | t: count: cart.item_count }}</span>
  </a>

  <div class="shopping-cart">
    <header class="clearfix">
    <span>
     <i class="fas fa-shopping-cart"></i>
     <small data-total-count>{{ cart.item_count }}</small>
    </span>
    <span class="total-span">
     <small>{{'cart.label.total' | t}} </small>
          <strong data-total-price>
            {{cart.total_price | money}} 
          </strong>
    </span>
    </header> 
    <div class="shopping-cart-body">
        <ul class="list-unstyled cart-items-list">
              {%- if  cart.item_count > 0 -%}
                    {%- for item in cart.items -%}
                      <li>
                        <figure class="image">
                          {%- if item.image !=blank -%}
                                <img src="{{ item.image | product_img_url: '75x'   }}" alt="{{item.title}}">
                          {%- else -%}
                            <img src="{{ 'empty.jpg' | asset_url }}"  alt="{{item.title}}">
                          {%- endif -%}
                          </figure>
                          <div class="cart-item-info">
                              <a href="{{-item.url-}}" class="title">{{item.title | truncate: 33 }}</a>
                              <p>
                                <span>{{item.final_line_price | money}}</span> 
                                <span>{{'cart.label.quantity' | t}} :  {{item.quantity}}</span>
                              </p>
                          </div>
                            <a href="#" title="{{'cart.general.remove' | t}}" data-id="{{item.id}}" class="del-cart-item-btn">
                               <i class="far fa-trash-alt"></i>
                            </a>
                      </li>
                  {%- endfor -%}
              {%- else -%}
                  <li>
                    <div class="alert alert-warning">
                    {{'cart.general.empty' | t}}
                    </div>
                  </li>
              {%- endif -%}
        </ul>
    </div>
    <footer class="text-center">
    {%- if  cart.item_count > 0 -%}
        <div>
          <a href="/checkout" class="btn btn-secondary w-40">{{'cart.general.checkout' | t}}</a>
          <a href="/cart" class="btn btn-secondary w-40">{{'cart.ajax_cart.go_to_cart' | t}}</a>
        </div>
    {%- else -%}
       <a href="/collections/all" class="btn btn-block btn-secondary">
                    {{ 'cart.ajax_cart.continue_shopping'  | t |  upcase }}
                    </a>
    {%- endif -%}
    </footer>
  </div>
</div>
 