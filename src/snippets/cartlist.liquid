   <div class="cart-box mx-2">
        <script>
      console.log({{cart |json}})
      </script>
         <a href="#" class="caret-btn">
              {% include 'icon-cart' %}
              {{ cart.item_count }} {{ 'layout.cart.items_count' | t: count: cart.item_count }}
        </a>
        <div class="cart-items">
          <div class="cart-header d-flex justify-content-between align-items-center">
          <span>
              {% include 'icon-cart' %}
              <small class="badge badge-info">{{ cart.item_count }}</small>
          </span>
          <span>
          <small>{{'cart.label.total' | t}} </small>
          <strong>
            {{cart.total_price | money}} 
          </strong>
          </span>
          </div>
            
          <div class="items-box">
            <ul class="list-unstyled content_cart">
            {%- for item in cart.items -%}
                <li class="d-flex justify-content-between align-items-center my-2">
                  <figure class="image">
                  {%- if item.image !=blank -%}
                        <img src="{{ item.image | product_img_url: '75x'   }}" alt="{{item.title}}">
                  {%- else -%}
                    <img src="{{ 'empty.jpg' | asset_url }}"  alt="{{item.title}}">
                  {%- endif -%}
                  </figure>
                  <div class="product-info">
                      <h5> <a href="{{-item.url-}}">{{item.title | truncate: 28 }}</a> </h5>
                      <p class="d-flex justify-content-between align-items-center">
                      <span>{{item.final_line_price | money}}</span> 
                      <small>{{'cart.label.quantity' | t}} {{item.quantity}}</small> 
                      </p>
                  </div>  
                </li>
            {%- endfor -%}
            </ul>
          </div>
          <div class="list-footer ">
            <a href="/cart" class="btn btn-block btn-danger btn-dark btn-lg">
                {{'layout.cart.go_to_cart' | t}}
            </a>
          </div>
        </div>
    </div>