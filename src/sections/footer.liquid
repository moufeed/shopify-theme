<footer class="main-footer py-5 text-light"  >
  <div class="container">
    <div class="row">
            <div class="col-md-4 col-lg-4">
                     <div class="footer-contact-info">
                        <h4 class="footer_title">{{'layout.footer.contact_us' | t}}</h4>
              {%- if section.settings.address_footer_text != blank -%}
              <span>
              <i class="fas fa-map-marker"></i>
                    <address>
                          {{section.settings.address_footer_text}}
                    </address>
              </span>
              {%- endif -%}
                {%- if section.settings.phone_footer_text != blank -%}
                    <span>
                    <i class="fas fa-phone"></i>
                      <strong dir="ltr">{{section.settings.phone_footer_text}}</strong>
                    </span>
                {%- endif -%}
                    {%- if section.settings.email_footer_text !=blank -%}
                        <span>
                          <i class="fas fa-envelope"></i>
                          <a href="mailto:{{section.settings.email_footer_text}}" dir="ltr">{{section.settings.email_footer_text}}</a>
                        </span>
                    {%- endif -%}
                     </div>
            </div>
            <div class="col-md-4 col-lg-4">
              {% include 'footer-menu' %}
            </div>
    </div>
  </div>
</footer>
 <div class="bottom-footer">
       <div class="container">
          <div class="row align-items-center justify-content-between">
              <div class="col-12 col-md-auto text-light">
              {% capture powered_by_link %}
              <a href="http://tamtech.solutions" target="_blank">{{'layout.footer.powered_by' | t: name:shop.name }}</a>
              {% endcapture %}
          {%- comment -%}
          {{ powered_by_link }}
          {%- endcomment -%}
              
                  {{ 'layout.footer.copyright' | t }} &copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: '/' }}
              </div> 
              <div class="col-12 col-md-auto">
                    {% if section.settings.show_payment_icons %}
                    {% unless shop.enabled_payment_types == empty %}
                      <span class="visually-hidden">{{ 'layout.footer.payment_methods' | t }}</span>
                      <div class="payment-icons">
                        {% for type in shop.enabled_payment_types %}
                            {{ type | payment_type_svg_tag: class: 'icon' }}
                        {% endfor %}
                      </div>
                    {% endunless %}
                  {% endif %}
              </div>
          </div>
        </div> 
  </div>
  
  {% schema %}
    {
       "name": "Footer",
       "settings" : [
         {
        "type": "checkbox",
        "id": "show_payment_icons",
        "default": true,
         "label": {
            "ar" : "Payment icons",
            "de": "Zahlungssymbole",
            "en": "Payment icons",
            "es": "Iconos de pago",
            "fr": "Icônes de paiement",
            "it": "Icone di pagamento",
            "ja": "支払いアイコン",
            "pt-BR": "Ícones de pagamento"
          }
        },
        {
          "type": "header",
          "content": {
            "ar" : "معلومات التواصل",
            "en" : "Contact information" 
          }
        },
        {
          "type" :"text",
          "id": "address_footer_text",
          "label": {
            "ar" : "العنوان",
            "en" : "Address" 
          }
        },{
          "type" :"text",
          "id": "phone_footer_text",
          "placeholder" :"Eg +900256123456",
          "label": {
            "ar" : "رقم الهاتف",
            "en" : "Phone number" 
          }
        },{
          "type" :"text",
          "id": "email_footer_text",
          "placeholder" :"info@website.com",
          "label": {
            "ar" : "البريد الالكتروني",
            "en" : "Email Address" 
          }
        },{
          "type" :"header",
          "content" :{
            "en":"Menu",
            "ar" :"القائمة"
          }
        },
        {
          "type" :"text",
          "id": "link_list_footer_heading",
          "label": {
            "ar" : "العنوان",
            "en" : "heading" 
          }
        },{
        "type":      "link_list",
        "id":        "linke_list_footer",
        "label":     {
          "en" :"Choose a Linklist",
          "ar" :"اختيار قائمة"
        }
      }
          
       ]
       
    }
  {% endschema %}
