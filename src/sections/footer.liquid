<footer class="main-footer py-5">
  <div class="container">
    <div class="row">
            <div class="col-md-3 col-lg-4">
              {%- if section.settings.address_footer_text != blank -%}
                    <address>
                        
                    </address>
              {%- endif -%}
            </div>
    </div>
  </div>
</footer>
 <div class="bottom-footer">
       <div class="container">
          <div class="row align-items-center justify-content-between">
              <div class="col-12 col-md-auto text-light">
              {% capture powered_by_link %}
              <a href="http://tamtech.solutions" target="_blank">{{'layout.footer.powered_by' | t: name:shop.name }}</a>
              {% endcapture %}
          {%- comment -%}
          {{ powered_by_link }}
          {%- endcomment -%}
              
                  {{ 'layout.footer.copyright' | t }} &copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: '/' }}
              </div> 
              <div class="col-12 col-md-auto">
                    {% if section.settings.show_payment_icons %}
                    {% unless shop.enabled_payment_types == empty %}
                      <span class="visually-hidden">{{ 'layout.footer.payment_methods' | t }}</span>
                      <div class="payment-icons">
                        {% for type in shop.enabled_payment_types %}
                            {{ type | payment_type_svg_tag: class: 'icon' }}
                        {% endfor %}
                      </div>
                    {% endunless %}
                  {% endif %}
              </div>
          </div>
        </div> 
  </div>
  
  {% schema %}
    {
       "name": "Footer",
       "settings" : [
         {
        "type": "checkbox",
        "id": "show_payment_icons",
        "default": true,
         "label": {
            "ar" : "Payment icons",
            "de": "Zahlungssymbole",
            "en": "Payment icons",
            "es": "Iconos de pago",
            "fr": "Icônes de paiement",
            "it": "Icone di pagamento",
            "ja": "支払いアイコン",
            "pt-BR": "Ícones de pagamento"
          }
        },{
          "type" :"text",
          "id": "address_footer_text",
          "label": {
            "ar" : "العنوان",
            "en" : "Address" 
          }
        }
       ]
       
    }
  {% endschema %}
